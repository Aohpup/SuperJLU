<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <WebView android:id="@+id/web" android:visibility="invisible"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/splash" android:orientation="vertical"
        android:gravity="center" android:background="#FFFFFF"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:text="JLU Toolkit" android:textSize="28sp" android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ProgressBar android:layout_marginTop="24dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/splash_msg" android:text="正在启动本地服务…"
            android:layout_marginTop="12dp" android:textColor="#6B7280"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/banner" android:visibility="gone"
        android:layout_gravity="bottom" android:background="#E6B45309" android:textColor="#FFFFFF"
        android:padding="12dp" android:textSize="14sp"
        android:text="连不上教务 / OA：校外请先连接学校 VPN（vpn.jlu.edu.cn）。点此关闭"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</FrameLayout>
