page { background:#f5f8f7; color:#203a35; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; font-size:28rpx; }
view,text,button,input { box-sizing:border-box; }
button { font-size:27rpx; border-radius:22rpx; line-height:1.5; padding:24rpx 28rpx; margin:0; }
button::after { border:0; }
button[disabled] { opacity:.45; }
input { height:80rpx; padding:0 22rpx; background:#f4f7f6; border:1rpx solid #dfe9e5; border-radius:16rpx; font-size:28rpx; }
.container { padding:32rpx 30rpx 60rpx; }
.eyebrow { font-size:21rpx; color:#6f8880; letter-spacing:4rpx; margin-bottom:12rpx; }
.title { font-size:48rpx; font-weight:700; letter-spacing:-1rpx; }
.subtitle { font-size:26rpx; color:#7d8e88; margin-top:12rpx; line-height:1.7; }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.stack { display:flex; flex-direction:column; gap:20rpx; }
.card { padding:28rpx; border-radius:26rpx; background:#fff; border:1rpx solid #e6ede9; margin-top:24rpx; }
.section { font-size:31rpx; font-weight:650; margin:36rpx 0 20rpx; }
.muted { color:#83958d; font-size:24rpx; line-height:1.7; }
.badge { display:inline-block; padding:7rpx 14rpx; border-radius:12rpx; background:#e6f4ee; color:#177c65; font-size:21rpx; }
.badge.warn { background:#fff1dc; color:#98713d; }
.primary { background:#167c67; color:#fff; }
.secondary { background:#e8f2ed; color:#226452; }
.ghost { background:transparent; color:#367363; padding:14rpx 0; }
.danger { color:#bd5a55; background:#fff0ee; }
.hint { padding:18rpx 22rpx; background:#edf3ef; color:#71857b; font-size:24rpx; border-radius:16rpx; line-height:1.7; margin-top:22rpx; }
.warning { background:#fff3e2; color:#98713d; }
.empty { text-align:center; padding:70rpx 20rpx; color:#8b9b93; font-size:26rpx; line-height:1.9; }
.divider { border-top:1rpx solid #edf1ee; margin:22rpx 0; }
.label { font-size:25rpx; color:#6e857b; margin:26rpx 0 12rpx; }
.link { color:#167c67; font-size:25rpx; }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; }
.grid3 { display:grid; grid-template-columns:repeat(3,1fr); gap:18rpx; }
.number { font-size:49rpx; font-weight:700; line-height:1.3; }
.small { font-size:22rpx; }
.chips { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:22rpx; }
.chip { padding:13rpx 21rpx; border-radius:100rpx; background:#eaf0ec; color:#71857a; font-size:23rpx; }
.chip.active { background:#167c67; color:#fff; }
.item-title { font-weight:600; line-height:1.6; }
.picker { padding:23rpx; border:1rpx solid #dfe9e5; border-radius:16rpx; background:#f4f7f6; }
.form-button { margin-top:28rpx; }
.footer { text-align:center; margin-top:42rpx; font-size:21rpx; color:#97a79d; letter-spacing:2rpx; }
