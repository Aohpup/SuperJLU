.summary{background:#167660;color:white;border-radius:28rpx;margin-top:28rpx;padding:30rpx}.summary-values{margin-top:30rpx}.summary .number{font-size:62rpx}.summary .small{color:#c4e4d5}.calculation-note{margin-top:17rpx}.filter{display:flex;align-items:center;gap:15rpx;margin:30rpx 0 20rpx}.filter input{flex:1;min-width:0}.term{font-size:22rpx;padding:18rpx 12rpx;max-width:260rpx}.grade-row{background:white;padding:25rpx 22rpx;display:flex;align-items:center;gap:18rpx;border-bottom:1rpx solid #edf2ee}.grade-row.failed{background:#fff1ef}.check{width:35rpx;height:35rpx;line-height:35rpx;border:2rpx solid #cddbd2;border-radius:10rpx;flex-shrink:0;text-align:center;color:white;font-size:25rpx}.check.checked{background:#168069;border-color:#168069}.grade-main{flex:1;min-width:0}.grade-main .muted{font-size:21rpx}.grade-score{font-size:35rpx;font-weight:650;color:#3e7960}.failed .grade-score{color:#bf6257}
