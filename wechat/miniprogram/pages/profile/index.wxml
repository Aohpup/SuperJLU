<view class="container"><view class="eyebrow">MY SUPERJLU</view><view class="title">我的校园空间</view>
<view class="card account"><view class="avatar">J</view><view><view class="item-title">{{mode === 'demo' ? '演示体验' : browserSync ? '手机浏览器数据' : bound ? '教务账号已绑定' : wxConnected ? '教务连接已就绪' : browserOnly ? '等待导入本人教务数据' : '等待连接真实教务'}}</view><view class="muted">{{browserSync || browserOnly ? '由本人从手机学校网页读取，数据保存在本机' : hybrid ? '云端处理学校认证，手机通过校园网查询教务' : direct ? '通过当前设备的校园网直连学校' : bound ? '可同步自己的课表、成绩和考试' : '完成学校认证后获取个人教务数据'}}</view></view></view>
<button class="primary form-button" bindtap="go" data-page="browser-sync">手机浏览器同步</button><button wx:if="{{!browserOnly}}" class="ghost form-button" bindtap="connect">绑定 / 重新登录教务（连接试验）</button><view class="hint" wx:if="{{browserSync}}">当前显示本人从手机学校网页读取的数据。重新同步请点“手机浏览器同步”，不需要电脑开机。</view><view class="hint" wx:if="{{!ready}}">当前未配置后端。可以直接体验演示功能；真实接入步骤见项目接入指南。</view>
<view class="section">教务与校历</view><view class="card settings"><view class="setting-row"><view><view class="item-title">数据模式</view><view class="muted">{{mode === 'demo' ? '演示数据' : browserSync ? '手机学校网页读取' : '学校接口试验'}}</view></view><text class="badge {{mode === 'demo' ? 'warn' : ''}}">{{mode === 'demo' ? '演示' : browserSync ? '本人导入' : bound ? '已绑定' : '未绑定'}}</text></view>
<view class="setting-row"><view><view class="item-title">第一周周一</view><view class="muted">校历自动获取，也可手动调整</view></view><picker mode="date" value="{{monday}}" bindchange="monday"><text class="link">{{monday || '选择日期'}} ▾</text></picker></view>
<view class="row"><button class="ghost" bindtap="resetMonday">恢复教务校历</button><button class="ghost" loading="{{busy}}" bindtap="refresh">同步教务 ↻</button></view><view class="muted">最近更新：{{updated}}</view></view>
<view class="hint warning" wx:if="{{syncError}}">{{syncError}}</view><button wx:if="{{direct}}" class="ghost form-button" bindtap="copyDiagnostic">复制连接诊断</button><view class="section">数据与隐私</view><view class="card settings"><view class="setting-row" bindtap="go" data-page="privacy"><text class="item-title">隐私说明与源码来源</text><text>›</text></view><view class="setting-row" bindtap="clearLocal"><text class="item-title">清除本地教务缓存</text><text>›</text></view><view class="setting-row" wx:if="{{mode === 'real'}}" bindtap="demo"><text class="item-title">切换演示模式</text><text>›</text></view></view>
<button wx:if="{{mode === 'real'}}" class="danger form-button" disabled="{{busy}}" bindtap="logout">清除教务数据与会话</button><view class="footer">SUPERJLU · WECHAT EDITION</view></view>
