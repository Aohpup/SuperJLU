<view class="container"><view class="eyebrow">CONNECT YOUR CAMPUS</view><view class="title">{{sms ? '验证码登录教务' : '把教务，装进口袋'}}</view><view class="subtitle">{{sms ? '使用统一身份认证中已绑定的密保手机号。' : '连接微信身份，再绑定统一认证账号。'}}<view>{{sms ? '先填写图形验证码，再接收学校短信。' : '账号为邮箱前缀，不是学号。'}}</view></view>
<view class="hint">{{hybrid ? '云端认证 + 校园网查询：手机号、验证码或账号密码经你配置的云端提交给学校。云端仅在内存保留本人认证会话，教务查询由手机直接完成，电脑可以关机。' : direct ? '校园网直连：手机号、验证码和所选学校账号仅发送给学校。会话只留在设备内存，本次登录无需输入密码。' : '服务地址：' + endpoint + '。学校密码仅用于此次验证，服务端保存加密会话。'}}</view>
<button wx:if="{{direct}}" class="ghost form-button" bindtap="checkNetwork" loading="{{checking}}" disabled="{{checking || busy}}">检测校园网连接</button><view wx:if="{{network}}" class="hint">{{network}}</view>
<view class="card" wx:if="{{step === 'idle'}}"><view class="row" wx:if="{{direct}}"><button class="ghost" bindtap="smsLogin" disabled="{{busy}}">短信验证码登录</button><button class="ghost" bindtap="passwordLogin" disabled="{{busy}}">账号密码登录</button></view><block wx:if="{{sms}}"><view class="label">学校已绑定的手机号</view><input type="number" placeholder="输入密保手机号" value="{{phone}}" data-field="phone" bindinput="field" maxlength="12"/></block><block wx:else><view class="label">统一身份认证账号</view><input placeholder="邮箱前缀（不含 @jlu.edu.cn）" value="{{username}}" data-field="username" bindinput="field" maxlength="100"/><view class="label">密码</view><input password placeholder="输入统一认证密码" value="{{password}}" data-field="password" bindinput="field" maxlength="256"/></block>
<view class="agreement"><checkbox-group bindchange="agree"><label><checkbox value="agree" checked="{{agreed}}" color="#167c67"/>我已阅读并同意</label></checkbox-group><text class="link" bindtap="privacy">隐私说明</text></view><button class="primary form-button" loading="{{busy}}" disabled="{{busy}}" bindtap="start">{{sms ? '获取图形验证码' : '微信登录并绑定教务'}}</button></view>
<view class="card" wx:if="{{step === 'need_sms_code' || step === 'sms_sent'}}"><view class="item-title">学校短信验证码</view><view class="muted">短信发送至你填写的密保手机。发送间隔为两分钟。</view>
<block wx:if="{{step === 'need_sms_code'}}"><view class="label">图形验证码</view><view class="row"><input style="flex:1;min-width:0" value="{{captchaCode}}" data-field="captchaCode" bindinput="field" placeholder="输入图片中的字符" maxlength="4"/><image class="captcha" src="{{captcha}}" mode="aspectFit"/></view><button class="ghost" disabled="{{busy}}" bindtap="captcha">看不清，换一张</button></block>
<button class="secondary form-button" disabled="{{busy || countdown > 0}}" loading="{{busy}}" bindtap="resend">{{countdown > 0 ? countdown + ' 秒后可重发' : step === 'sms_sent' ? '更换图片后重新发送' : '发送短信验证码'}}</button>
<block wx:if="{{step === 'sms_sent'}}"><view class="label">6 位短信验证码</view><input type="number" value="{{smsCode}}" data-field="smsCode" bindinput="field" placeholder="输入学校发送的短信验证码" maxlength="6"/><button class="primary form-button" disabled="{{busy}}" loading="{{busy}}" bindtap="verify">验证并登录教务</button></block><button class="ghost form-button" disabled="{{busy}}" bindtap="restart">更换手机号 / 重新开始</button></view>
<view class="card" wx:if="{{step === 'choose_sms_account'}}"><view class="item-title">选择学校账号</view><view class="muted">该手机号绑定了多个账号，请选择本次要登录的账号。</view><button wx:for="{{accounts}}" wx:key="index" class="secondary form-button" data-index="{{item.index}}" disabled="{{busy}}" bindtap="chooseAccount">{{item.label}}</button><button class="ghost form-button" disabled="{{busy}}" bindtap="restart">取消并重新开始</button></view>
<view class="card" wx:if="{{step === 'need_second_factor' || step === 'code_sent'}}"><view class="item-title">学校二次验证</view><view class="muted">验证码由学校发送到「智慧吉大」，按学校要求完成认证。</view>
<block wx:if="{{step === 'need_second_factor'}}"><view class="label">图形验证码</view><view class="row"><input style="flex:1;min-width:0" value="{{captchaCode}}" data-field="captchaCode" bindinput="field" placeholder="输入图片中的字符" maxlength="20"/><image class="captcha" src="{{captcha}}" mode="aspectFit" bindtap="captcha"/></view><button class="ghost" disabled="{{busy}}" bindtap="captcha">看不清，换一张</button></block>
<button class="secondary form-button" disabled="{{busy || countdown > 0}}" loading="{{busy}}" bindtap="resend">{{countdown > 0 ? countdown + ' 秒后可重发' : step === 'code_sent' ? '更换验证码并重发' : '发送微信验证码'}}</button>
<block wx:if="{{step === 'code_sent'}}"><view class="label">微信验证码</view><input value="{{wechatCode}}" data-field="wechatCode" bindinput="field" placeholder="输入学校发送的验证码" maxlength="20"/><button class="primary form-button" disabled="{{busy}}" loading="{{busy}}" bindtap="verify">验证并同步教务</button></block><button class="ghost form-button" disabled="{{busy}}" bindtap="restart">重新输入账号</button></view>
<view class="card success" wx:if="{{step === 'success'}}"><view class="success-symbol">✓</view><view class="section">已完成教务绑定</view><view class="hint warning" wx:if="{{syncError}}">学校认证已完成，数据同步未完成：{{syncError}}</view><button wx:if="{{syncError}}" class="secondary form-button" disabled="{{busy}}" loading="{{busy}}" bindtap="retrySync">重新同步教务</button><view class="muted" wx:else>可以查看自己的校园日程了。部分模块若未同步完成，可在「我的」再次同步。</view><button class="primary form-button" bindtap="done">查看我的今日安排</button></view><view class="hint warning" wx:if="{{error}}">{{error}}</view></view>
