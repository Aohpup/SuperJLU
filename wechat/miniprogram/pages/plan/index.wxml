<view class="container"><view class="eyebrow">YOUR ACADEMIC JOURNEY</view><view class="title">一步一步，走向毕业</view><view class="hint warning" wx:if="{{mode === 'demo'}}">当前为示例培养方案和示例进度。</view>
<view class="card"><view class="item-title">{{plan}}</view><view class="row" style="margin-top:28rpx"><view><text class="number">{{earned}}</text><text class="muted"> / {{required}} 学分</text></view><text class="badge">{{progress}}%</text></view><progress percent="{{progress}}" activeColor="#167c67" backgroundColor="#edf3ee" stroke-width="8" border-radius="8" style="margin-top:22rpx"/></view>
<view class="section">各课组完成情况</view><view wx:for="{{groups}}" wx:key="code" class="card"><view class="row"><view class="item-title">{{item.name}}</view><text class="badge {{item.passed ? '' : 'warn'}}">{{item.passed ? '已完成' : '进行中'}}</text></view><view class="muted">已获 {{item.earned === null || item.earned === undefined ? '—' : item.earned}} / 要求 {{item.required === null || item.required === undefined ? '—' : item.required}} 学分</view></view>
<view class="section">方案课程</view><view class="chips"><text wx:for="{{filters}}" wx:key="*this" class="chip {{filter === item ? 'active' : ''}}" bindtap="filter" data-filter="{{item}}">{{item}}</text></view>
<view wx:for="{{courses}}" wx:key="name" class="card"><view class="row"><text class="item-title">{{item.name}}</text><text class="badge">{{item.status}}</text></view><view class="muted">{{item.credit}} 学分 · {{item.nature}} · {{item.group}}</view></view><view wx:if="{{!courses.length}}" class="empty">暂无课程明细。登录后同步教务以获取培养方案。</view><view class="hint">已获学分可能由成绩推算，毕业资格以学院审核为准。</view></view>
