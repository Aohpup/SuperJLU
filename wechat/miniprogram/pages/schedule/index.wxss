.week-bar{text-align:center;margin:34rpx 0 8rpx;background:white;border-radius:24rpx;padding:19rpx}.week-arrow{background:#f0f5f1;width:80rpx;padding:8rpx;font-size:44rpx}.week-title{font-size:36rpx;font-weight:650}.schedule-scroll{margin-top:25rpx;border-radius:20rpx;background:white}.schedule-head{display:grid;grid-template-columns:70rpx repeat(7,130rpx);width:980rpx;padding-top:20rpx}.day{text-align:center;font-size:24rpx;line-height:1.7}.schedule-grid{display:grid;grid-template-columns:70rpx repeat(7,130rpx);grid-auto-rows:95rpx;width:980rpx;gap:0;background:repeating-linear-gradient(to bottom,transparent,transparent 94rpx,#f0f4f1 94rpx,#f0f4f1 95rpx);padding-top:14rpx}.period{text-align:center;font-size:24rpx;color:#8b9b92;padding-top:18rpx}.period text{font-size:16rpx}.lesson{border-radius:12rpx;padding:12rpx 9rpx;margin:3rpx;font-size:22rpx;line-height:1.45;overflow:hidden;border:1rpx solid #ffffff}.lesson text{display:block;font-size:18rpx;opacity:.7;margin-top:10rpx}.tone0{background:#deefe4;color:#39745d}.tone1{background:#e1eaf4;color:#4d7092}.tone2{background:#f4e7d8;color:#94714e}.tone3{background:#ebe5f3;color:#7d6b93}.tone4{background:#f2e2e1;color:#9c716f}
