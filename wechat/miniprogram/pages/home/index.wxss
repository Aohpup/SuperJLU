.greeting{font-size:57rpx;font-weight:700;line-height:1.48;letter-spacing:-2rpx;margin:24rpx 0 20rpx}.hero{background:#167660;border-radius:30rpx;color:white;padding:30rpx;margin-top:30rpx}.hero-tag{font-size:22rpx;color:#b4ded0}.hero-title{font-size:36rpx;font-weight:600;margin:29rpx 0 16rpx}.hero-meta{font-size:24rpx;color:#daeee6;line-height:1.8}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin:34rpx 0}.quick{text-align:center;font-size:23rpx;color:#607b6c}.quick-icon{width:90rpx;height:90rpx;border-radius:26rpx;line-height:90rpx;font-size:40rpx;margin:0 auto 16rpx}.mint{background:#e2f0e7;color:#297e62}.peach{background:#f9ece0;color:#aa784f}.blue{background:#e5edf4;color:#5a7e97}.lilac{background:#ece8f3;color:#8b78a1}.course-row{display:flex;gap:23rpx;align-items:center;background:white;padding:27rpx 24rpx;margin-top:16rpx;border-radius:22rpx}.course-time{width:190rpx;font-size:23rpx;flex-shrink:0}.course-line{width:5rpx;height:64rpx;background:#74b69b;border-radius:5rpx;flex-shrink:0}.sync-row{margin-top:24rpx}
