# Copy to .env. Never put AppSecret into the Mini Program.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SUPERJLU_MASTER_KEY=
SUPERJLU_HOST=127.0.0.1
SUPERJLU_PORT=8787
SUPERJLU_DATA_DIR=.data
# Only for local backend testing; never enable on a public service.
SUPERJLU_ALLOW_DEV_LOGIN=0
# Direct school connections bypass machine HTTP proxy settings, within this process only.
SUPERJLU_DIRECT_SCHOOL=1
